# Copy to .env and adjust for local or Railway

# Database — Railway Postgres often provides DATABASE_URL as postgres://…
# (asyncpg driver is applied automatically)
DATABASE_URL=postgresql+asyncpg://searchfit:searchfit@127.0.0.1:5432/searchfit
# Local SQLite fallback:
# DATABASE_URL=sqlite+aiosqlite:///./searchfit.db

REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1

# REQUIRED in production — placeholders are rejected at startup
SECRET_KEY=change-me-in-production-use-a-long-random-string
ENCRYPTION_KEY=change-me-fernet-key-base64-32bytes==
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

ANTHROPIC_API_KEY=
# Skill synthesis (competitor analysis, discovery, SEO scoring)
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
SKILL_MODEL=google/gemini-2.5-pro
ROUTER_MODEL=claude-haiku-4-5
USE_MOCK_LLM=false
USE_MOCK_PROVIDERS=false

# Optional live SEO APIs (without these, live site HTML + Claude are used instead)
AHREFS_API_KEY=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
MOZ_API_KEY=

# Google OAuth (GA4 / GSC / GTM / Google Business Profile)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Set these to your public Railway URL in production
OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/oauth/callback
FRONTEND_URL=http://localhost:5173

# 0 = take every page discovered (recommended). Optional soft cap if you need one.
SEO_AUDIT_MAX_PAGES=0
COMPETITOR_CACHE_DAYS=14
READINESS_THRESHOLD=90.0

FEATURE_DISCOVERY_AGENT=true
FEATURE_TRACKING_AGENT=true
FEATURE_WEBSITE_AGENT=true
FEATURE_COMPETITOR_AGENT=true

# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# development | production (production skips demo user/client seeding)
ENVIRONMENT=development

# Never leave true on a public Railway deployment
AUTH_DISABLED=true

# Optional: path to built SPA (set automatically in the production Docker image)
# STATIC_DIR=/app/static
