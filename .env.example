# Copy to .env and adjust for local or Railway

# Database — Railway Postgres often provides DATABASE_URL as postgres://…
# (asyncpg driver is applied automatically)
DATABASE_URL=postgresql+asyncpg://searchfit:searchfit@127.0.0.1:5432/searchfit
# Local SQLite fallback:
# DATABASE_URL=sqlite+aiosqlite:///./searchfit.db

REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1

# REQUIRED in production — placeholders are rejected at startup
SECRET_KEY=change-me-in-production-use-a-long-random-string
ENCRYPTION_KEY=change-me-fernet-key-base64-32bytes==
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

ANTHROPIC_API_KEY=
# Skills always call Anthropic Claude Sonnet directly (ANTHROPIC_API_KEY).
# OpenRouter is only for Perplexity research + draft image generation.
# - ROUTER_MODEL: cheap skill picker (Haiku, Anthropic)
# - SKILL_MODEL: every skill's reasoning model (Claude Sonnet). This is the
#   repo's name for what other docs call CLAUDE_MODEL — one setting, not two.
#   Claude is used for relevance, labelling and clustering only, never for
#   generating a metric.
LLM_PROVIDER=anthropic
OPENROUTER_API_KEY=
SKILL_MODEL=claude-sonnet-5
# Optional alias. If set, this replaces SKILL_MODEL.
# CLAUDE_MODEL=claude-sonnet-5
COMPETITOR_MODEL=claude-sonnet-5
# Nano Banana — draft hero / supporting images (OpenRouter)
IMAGE_MODEL=google/gemini-2.5-flash-image
# Phase 10 article drafts use SKILL_MODEL on Anthropic
WRITE_MODEL=claude-sonnet-5
KEYWORD_CLUSTER_MODEL=claude-sonnet-5
# Token savers for Phase 5 keyword filtering (optional overrides)
# KEYWORD_RELEVANCE_MAX_PER_SEED=25
# KEYWORD_RELEVANCE_MAX_INPUT_PER_SEED=40
# KEYWORD_RELEVANCE_MAX_TOKENS=2048
# KEYWORD_CLUSTER_USE_LLM=false
ROUTER_MODEL=claude-haiku-4-5
USE_MOCK_LLM=false
USE_MOCK_PROVIDERS=false

# Optional live SEO APIs (without these, live site HTML + Claude are used instead)
# Phase 5 keyword research: Ahrefs + DataForSEO (volumes never invented)
AHREFS_API_KEY=
# Keyword + organic lookups. Backlinks use this key first, then Ahrefs, then Moz.
SEMRUSH_API_KEY=
# Phase 7 Site Audit: optional project id (otherwise resolved by client URL — free lookup)
# AHREFS_SITE_AUDIT_PROJECT_ID=
# AHREFS_SITE_AUDIT_PAGE_LIMIT=0
# AHREFS_SITE_AUDIT_ISSUE_SAMPLE_LIMIT=3
# Phase 7 chat-turn budget (seconds) — Ahrefs + CWV + validation need headroom
# TECHNICAL_SEO_AGENT_TIMEOUT_SECONDS=900
# Fallback crawl page cap when Ahrefs Site Audit is unavailable
# TECHNICAL_SEO_SEO_AUDIT_MAX_PAGES=40
# DataForSEO — Basic auth. Every keyword metric (search volume, CPC,
# competition, difficulty, intent) comes from this provider; nothing is
# estimated, and missing data stays null / displays as N/A.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Every request sets location and language explicitly. These are the fallbacks
# used when a client's geographic focus resolves to nothing; a project may
# override either. 2840 = United States, 2036 = Australia, 2826 = UK.
DATAFORSEO_LOCATION_CODE=2840
DATAFORSEO_LANGUAGE_CODE=en
# SERP-overlap cluster refinement — one paid Live SERP call per head term
# (DataForSEO live endpoints do not batch). Default 40 / concurrency 10.
# SERP_CLUSTERING_ENABLED=true
# SERP_CLUSTERING_HEAD_TERMS=40
# SERP_CLUSTERING_CONCURRENCY=10
SERP_CLUSTERING_MIN_SHARED=4
# Labs expansion floor, pushed to DataForSEO as a search_volume filter.
KEYWORD_EXPAND_MIN_VOLUME=10
# related_keywords hop depth (0-4).
KEYWORD_RELATED_DEPTH=2
# Flag when Google Ads volume and clickstream volume differ by more than this ratio.
VOLUME_DISCREPANCY_RATIO=2
# Claude relevance batches. SKILL_MODEL is the model id; CLAUDE_MODEL overrides it.
KEYWORD_VALIDATION_BATCH_SIZE=200
# DATAFORSEO_SANDBOX=true sends keyword calls to sandbox.dataforseo.com
DATAFORSEO_SANDBOX=false
# Stop DataForSEO calls once today's recorded spend would cross this many USD. 0 disables the cap.
DATAFORSEO_DAILY_BUDGET_USD=0
MOZ_API_KEY=

# Google OAuth (GA4 / GSC / GTM / Google Business Profile)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Set these to your public Railway URL in production
OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/oauth/callback
FRONTEND_URL=http://localhost:5173

# --- Phase 12: design fetch, preview, publish ---------------------------------
# Context.dev: computed browser styles, fonts, and screenshots of the live page.
# Keyword research does not use this key. Blank skips the paid readers.
CONTEXT_DEV_API_KEY=
# Brandfetch: pulls the client's logo / colour palette / fonts for the publish preview
BRANDFETCH_API_KEY=
# Firecrawl: scrapes a reference page so the preview matches the live site's structure
FIRECRAWL_API_KEY=

# --- Content Production: client-site preview (Manus agent) --------------------
# "Preview on client site" sends the draft to a Manus agent, which lays it out in
# the client's own site design and returns one HTML page. Review only: WordPress
# still gets the clean draft. Blank key = the preview button reports "not set up".
MANUS_API_KEY=
# Optional: a Manus project (id, or exact name) to group preview tasks under.
MANUS_PROJECT_ID=
MANUS_PROJECT_NAME=
# Connector names the agent may use (comma separated; matched to your installed connectors).
MANUS_CONNECTORS=Firecrawl
# standard | lite | max
MANUS_AGENT_PROFILE=standard
MANUS_TIMEOUT_MINUTES=90
# Dollar price of one Manus credit. 0 = record credits only, cost shown as unknown.
MANUS_USD_PER_CREDIT=0

# WordPress is NOT configured here. Each client connects their own site + Application
# Password from inside the app (Publishing card → Connect WordPress) — this tool runs
# many clients, so there is no single deployment-wide WordPress site. Credentials are
# stored encrypted per client (app.api.integrations / ApiCredential).
#
# These two stay global: they are a safety ceiling every client connection is bound by,
# not a credential.
# draft | publish | pending. Leave as draft: anything else writes to the live site.
WORDPRESS_DEFAULT_STATUS=draft
# Must be true before Phase 12 can push a post live. Off means drafts only.
WORDPRESS_ALLOW_LIVE_PUBLISH=false

# 0 = take every page discovered (recommended). Optional soft cap if you need one.
SEO_AUDIT_MAX_PAGES=0
# Phase 3 interactive budgets (seconds). SEO audit is heavier than crawl/backlinks.
# WEBSITE_OPERATION_TIMEOUT_SECONDS=75
# WEBSITE_SEO_AUDIT_TIMEOUT_SECONDS=240
COMPETITOR_CACHE_DAYS=14
READINESS_THRESHOLD=90.0

FEATURE_DISCOVERY_AGENT=true
FEATURE_TRACKING_AGENT=true
FEATURE_WEBSITE_AGENT=true
FEATURE_COMPETITOR_AGENT=true
FEATURE_SEARCH_DEMAND_AGENT=true
FEATURE_CONTENT_STRATEGY_AGENT=true
FEATURE_SITE_ARCHITECTURE_AGENT=true

# Post-phase company-aware validation (deterministic + AI QC)
FEATURE_PHASE_VALIDATION=true
# Max generate→validate cycles before escalating to reject (default 2)
VALIDATION_MAX_ATTEMPTS=2

# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# development | production (production skips demo user/client seeding)
ENVIRONMENT=development

# Bypasses login and ALL role/permission checks. Matches the code default (false).
# Only flip to true for a throwaway local demo, never on anything reachable.
AUTH_DISABLED=false

# Optional: path to built SPA (set automatically in the production Docker image)
# STATIC_DIR=/app/static

# --- Operational dead man's switch -------------------------------------------
# When enabled, an operator must check in within DEAD_MAN_SWITCH_MAX_DAYS or
# the API locks (503) until check-in. Health + SPA stay up; no data is deleted.
# DEAD_MAN_SWITCH_ENABLED=false
# DEAD_MAN_SWITCH_TOKEN=generate-a-long-random-string
# DEAD_MAN_SWITCH_MAX_DAYS=14
# Check-in:
#   curl -X POST "$URL/api/v1/ops/dead-man-switch/check-in" \
#     -H "X-Dead-Man-Switch-Token: $DEAD_MAN_SWITCH_TOKEN" \
#     -H "Content-Type: application/json" -d '{"note":"weekly ok"}'
# Status:
#   curl "$URL/api/v1/ops/dead-man-switch/status" \
#     -H "X-Dead-Man-Switch-Token: $DEAD_MAN_SWITCH_TOKEN"

# --- Railway production checklist --------------------------------------------
# Bind port is injected by Railway (scripts/start.sh reads PORT, default 8000).
# PORT=8080
#
# On the web service set:
#   ENVIRONMENT=production
#   AUTH_DISABLED=false
#   SECRET_KEY=<python -c "import secrets; print(secrets.token_urlsafe(48))">
#   ENCRYPTION_KEY=<python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())">
#   DATABASE_URL=<Railway Postgres plugin — postgres:// is auto-normalized to asyncpg>
#   A public URL that includes ?sslmode=require is accepted; asyncpg cannot take that query parameter.
#   REDIS_URL=<Railway Redis plugin>
#   CELERY_BROKER_URL=<same Redis or redis://.../1>
#   FRONTEND_URL=https://<your-public-domain>
#   OAUTH_REDIRECT_URI=https://<your-public-domain>/api/v1/oauth/callback
#   CORS_ORIGINS=https://<your-public-domain>
# If those three are still localhost, production uses https://$RAILWAY_PUBLIC_DOMAIN
# (set automatically by Railway). Set them yourself for a custom domain.
#   USE_MOCK_LLM=false
#   USE_MOCK_PROVIDERS=false
# Optional separate Railway services can use Procfile `worker` / `beat`
# (scripts/start-worker.sh / scripts/start-beat.sh).
#
# Healthcheck path: /healthz  (also available as /health)
